{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && SKIP_PRISMA_GENERATE=1 npm install --include=dev",
      "buildCommand": "cd ../.. && npm run build:web",
      "outputDirectory": "dist",
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=()"
            },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co/storage/v1/object/public/; font-src 'self' data:; connect-src 'self' https://*.supabase.co/storage/v1/object/public/; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.mts",
      "installCommand": "cd ../.. && npm install --include=dev",
      "buildCommand": "cd ../.. && npm run build:api",
      "functions": {
        "src/main.mts": {
          "maxDuration": 30,
          "includeFiles": "package.json"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
